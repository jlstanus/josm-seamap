<?xml version="1.0" encoding="UTF-8"?>
<presets xmlns="http://josm.openstreetmap.de/tagging-preset-1.0" 
           author="Malcolm Herring; Gemini Adaptive AI" 
           version="1.1_2026.04.22" 
           shortdescription="Water Sports Pro" 
           fr.shortdescription="Sports Nautiques Pro"
           de.shortdescription="Wassersport Pro">

  <group name="Water Sports" de.name="Wassersport" fr.name="Sports nautiques" icon="https://raw.githubusercontent.com/jlstanus/josm-seamap/master/icons/png/sailing.png">
    
    <item name="Windsurfing" de.name="Wind-Surfen" fr.name="Planche à voile" icon="https://raw.githubusercontent.com/jlstanus/josm-seamap/master/icons/png/windsurfing.png" type="node,closedway,area">
      <link href="http://wiki.openstreetmap.org/wiki/Tag:sport=windsurfing" />
      <label text="Windsurfing Area / Spot" fr.text="Zone / Spot de Planche à voile"/>
      <key key="sport" value="windsurfing"/>
      <text key="name" text="Name" fr.text="Nom du spot"/>
      <combo key="leisure" text="Type of place" fr.text="Type de lieu" values="sports_centre,beach_resort" delete_if_empty="true"/>
      <check key="seamark:type" value_on="restricted_area" value_off="" text="Marine Restricted Area" fr.text="Zone à accès restreint" default="off" delete_if_empty="true"/>
    </item>

    <item name="Kitesurfing" de.name="Kite-Surfen" fr.name="Kite-surf" icon="kitesurfing" type="node,closedway,area">
      <key key="sport" value="kitesurfing"/>
      <text key="name" text="Name" fr.text="Nom du spot"/>
      <check key="seamark:type" value_on="restricted_area" value_off="" text="Marine Restricted Area" default="off" delete_if_empty="true"/>
    </item>

    <item name="Surfing" de.name="Surfen" fr.name="Surf" icon="surfing" type="node,closedway,area">
      <key key="sport" value="surfing"/>
      <text key="name" text="Name" fr.text="Nom"/>
      <check key="seamark:type" value_on="restricted_area" value_off="" text="Marine Restricted Area" default="off" delete_if_empty="true"/>
    </item>

    <item name="Swimming" de.name="Schwimmen" fr.name="Natation / Baignade" icon="swimming" type="node,closedway,area">
      <key key="sport" value="swimming"/>
      <key key="leisure" value="swimming_area"/>
      <text key="name" text="Beach Name" fr.text="Nom de la plage / zone"/>
      <check key="seamark:type" value_on="restricted_area" value_off="" text="Swimming Restricted Area" default="off"/>
    </item>

    <item name="Scuba Diving" de.name="Tauchen" fr.name="Plongée" icon="scuba_diving" type="node,closedway">
      <key key="sport" value="scuba_diving"/>
      <text key="name" text="Dive Site Name" fr.text="Nom du site de plongée"/>
      <check key="seamark:type" value_on="restricted_area" value_off="" text="Restricted Area" default="off"/>
    </item>

    <separator/>

    <item name="Launch / Slipway" fr.name="Cale de mise à l'eau" icon="presets/transport/way/way_service.svg" type="node,way">
      <key key="leisure" value="slipway"/>
      <combo key="surface" text="Surface" values="concrete,sand,gravel,wood"/>
      <combo key="slope" text="Slope" values="gentle,steep"/>
    </item>

    <separator/>

    <group name="Whitewater" de.name="Wildwasser" fr.name="Eaux vives" icon="rapid">
      <item name="Put-in / Egress" fr.name="Embarquement / Débarquement" icon="presets/transport/way/way_service.svg" type="node">
        <key key="whitewater" value="put_in;egress"/>
        <text key="whitewater:name" text="Access name" fr.text="Nom de l'accès"/>
      </item>
      
      <item name="Rapid (Graded)" fr.name="Stromschnelle (Classée)" icon="rapid" type="node">
        <key key="whitewater" value="rapid"/>
        <combo key="whitewater:rapid_grade" text="Rapid Grade" fr.text="Classe" values="1,2,3,4,5,6"/>
        <text key="whitewater:name" text="Rapid name" fr.text="Nom de la rapide"/>
      </item>

      <item name="Hazard" fr.name="Danger / Obstacle" icon="danger" type="node">
        <key key="whitewater" value="hazard"/>
        <combo key="hazard" text="Type" values="rock,tree,weir"/>
        <text key="description" text="Description" fr.text="Description du danger"/>
      </item>
    </group>

  </group>
</presets>
